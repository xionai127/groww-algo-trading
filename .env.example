# Environment Configuration
APP_ENV=development
LOG_LEVEL=INFO

# Application Execution Mode: ANALYSIS | PAPER | LIVE (Default: ANALYSIS)
# Live mode can only be engaged with explicit confirmation.
EXECUTION_MODE=ANALYSIS

# Groww API Credentials (Leave empty to configure via Browser Dashboard)
GROWW_API_KEY=
GROWW_API_SECRET=
GROWW_ACCESS_TOKEN=
GROWW_TOTP_KEY=

# Capital & Risk Controls (Defaults in INR)
STARTING_CAPITAL=10000.00
MAX_DAILY_LOSS=500.00
RISK_PER_TRADE=100.00
MAX_TRADES_PER_DAY=5
MAX_OPEN_POSITIONS=1
STOP_LOSS_PERCENT=10.0
TARGET_PERCENT=20.0

# Trading Instruments & Session
TRADING_INSTRUMENTS=NIFTY,SENSEX
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30
SQUARE_OFF_TIME=15:15

# Database Settings
DATABASE_PATH=database/groww_algo.db
